# Copier en .env.local pour surcharger. Toutes les variables sont optionnelles.

# Modele de hand tracking. Par defaut : CDN Google.
# Pour un jeu 100 % hors ligne : `npm run fetch:model` puis decommente la ligne.
#VITE_HAND_MODEL_URL=./models/hand_landmarker.task

# Dossier des binaires wasm MediaPipe.
# Par defaut : ./mediapipe/wasm (copie depuis node_modules par predev/prebuild).
#VITE_MEDIAPIPE_WASM_PATH=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm

# Musique. Par defaut : piste generee par Tone.js, calee sur les phases.
# Depose ton fichier dans public/music/ et cale les `t` de ta beatmap dessus.
#VITE_MUSIC_URL=./music/mon-morceau.mp3
