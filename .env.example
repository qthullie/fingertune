# Copy to .env.local to override. Every variable is optional.

# Hand-tracking model. Default: Google's CDN.
# For a fully offline game: `npm run fetch:model`, then uncomment this line.
#VITE_HAND_MODEL_URL=./models/hand_landmarker.task

# Folder holding the MediaPipe wasm binaries.
# Default: ./mediapipe/wasm (copied from node_modules by predev/prebuild).
#VITE_MEDIAPIPE_WASM_PATH=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14/wasm

# Music. Default: a track generated by Tone.js, following the phases.
# Drop your file in public/music/ and align your beatmap's `t` values to it.
#VITE_MUSIC_URL=./music/my-track.mp3
