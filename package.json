{
  "name": "fingertune",
  "version": "0.1.0",
  "private": false,
  "description": "An Osu!-style rhythm game played by pinching your fingers, tracked from a webcam with MediaPipe Hand Landmarker. Runs entirely in the browser.",
  "keywords": [
    "hand-tracking",
    "mediapipe",
    "gesture-recognition",
    "computer-vision",
    "rhythm-game",
    "one-euro-filter",
    "webcam",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/qthullie/fingertune#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qthullie/fingertune.git"
  },
  "bugs": {
    "url": "https://github.com/qthullie/fingertune/issues"
  },
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "predev": "node scripts/copy-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "tsc --noEmit && node scripts/check-beatmaps.mjs && vite build",
    "build:standalone": "vite build --mode standalone && node scripts/copy-standalone.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch:model": "node scripts/fetch-model.mjs",
    "check:beatmaps": "node scripts/check-beatmaps.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tone": "^14.8.49"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
