# Normalise line endings: LF in the repository, whatever the contributor's OS.
# Without this, a Windows checkout rewrites files as CRLF and the generated
# single-file build shows a phantom diff on every rebuild.
* text=auto eol=lf

# Generated by `npm run build:standalone`. Collapsed in GitHub diffs and left out
# of the language statistics; it is a build artifact that happens to be committed
# so the game can be opened straight from the repository.
standalone/fingertune.html linguist-generated=true

# Binaries, never touched.
*.png binary
*.jpg binary
*.mp3 binary
*.wav binary
*.task binary
